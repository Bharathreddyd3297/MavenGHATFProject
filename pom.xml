<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        We inherit from spring-boot-starter-parent so we get sensible default
        versions for all Spring dependencies and plugins. This means we don't
        have to manually pick a version for every single library.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>

    <groupId>com.streamflix</groupId>
    <artifactId>streamflix</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>StreamFlix</name>
    <description>A simple Netflix-inspired movie catalog application built with Spring Boot and Maven, used to teach the Java/Maven build lifecycle for a DevOps training project.</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- Lets us build web pages (controllers) and render them with Thymeleaf -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Server-side HTML templating engine used for our pages -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Testing tools: JUnit 5, Spring Test, AssertJ, Mockito, etc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- This makes the final JAR name predictable: target/streamflix-1.0.0.jar -->
        <finalName>${project.artifactId}-${project.version}</finalName>

        <plugins>
            <!-- Packages the app as an executable ("fat") JAR that includes an embedded server -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
